{
  // Cloudflare settings for r3ai.dev. The site is plain files served from ./dist.
  // The server code, worker/index.js, saves post requests from /request/ and runs the unlisted pages (the bus tracker and Limiting Factor).
  // The tracker reads secrets set in the dashboard, never here: ZONAR_CUSTOMER, ZONAR_USERNAME, ZONAR_PASSWORD,
  // GEOTAB_DATABASE, GEOTAB_USERNAME, GEOTAB_PASSWORD (and GEOTAB_SERVER, GEOTAB_BUSES if needed),
  // and PARA_FEED_KEY, shared with the paratransit-app Worker so only it can read the paratransit vans' positions.
  "name": "r3ai-dev",
  "compatibility_date": "2026-09-22",
  // Keep variables added in the Cloudflare dashboard when a push redeploys the Worker.
  "keep_vars": true,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Unlisted pages are served by the Worker, so it has to see these addresses before the file server does.
    "run_worker_first": ["/work/lobby-display/*", "/work/limiting-factor/*"]
  },
  // Where post requests are stored.
  "d1_databases": [
    { "binding": "DB", "database_name": "r3ai-requests", "database_id": "d69b294e-84e4-4568-b6da-3ee739dea136" }
  ],
  // Cloudflare's AI models, used by Ask the site (/ask/). Runs on the free daily allowance.
  "ai": { "binding": "AI" },
  // The bus tracker follows the buses every minute on weekdays, 10:00 to 23:59 UTC (early morning to evening in
  // Lake Charles, summer or winter), so it keeps each bus's route when nobody has the page open.
  "triggers": { "crons": ["* 10-23 * * MON-FRI"] },
  // Attaches the domain automatically on each deploy.
  "routes": [
    { "pattern": "r3ai.dev", "custom_domain": true }
  ]
}
